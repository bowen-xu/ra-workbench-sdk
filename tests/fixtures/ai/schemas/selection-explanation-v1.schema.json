{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-assistant.local/schemas/selection-explanation-v1.schema.json",
  "title": "SelectionExplanationCandidateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "statements", "uncertainties"],
  "properties": {
    "kind": { "const": "selection_explanation_v1" },
    "schemaVersion": { "const": 1 },
    "statements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/statement" }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  },
  "$defs": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "epistemicRole", "evidenceItemIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 64 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "epistemicRole": {
          "enum": ["source_paraphrase", "synthesis", "inference", "uncertain"]
        },
        "evidenceItemIds": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    }
  }
}
